# GENOMA local development
# Copy to .env and adjust as needed.

GENOMA_HOST=0.0.0.0
GENOMA_PORT=8080
GENOMA_PUBLIC_URL=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://genoma:genoma@localhost:5432/genoma

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage (used when GENOMA_STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=genoma
S3_ACCESS_KEY=genoma
S3_SECRET_KEY=genoma-secret
S3_USE_PATH_STYLE=true

# Blob storage: fs (default, zero-config local) or s3 (MinIO / S3-compatible)
GENOMA_BLOB_DIR=./data/uploads
GENOMA_STORAGE_BACKEND=fs

# Analysis
GENOMA_MAX_UPLOAD_BYTES=2147483648
GENOMA_DEFAULT_CHUNK_SIZE=1048576
GENOMA_PI_DIGITS_PATH=./data/pi/pi-digits.bin
GENOMA_DEMO_DIR=./data/demos
GENOMA_RATE_LIMIT_PER_MINUTE=120

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth (optional; default off so demos/CI stay token-free)
GENOMA_AUTH_REQUIRED=false
